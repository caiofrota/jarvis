# Optional local web/server port. The runtime defaults to 4318.
PORT=4318

# Test-only Electron data directory. Leave empty for normal development.
JARVIS_TEST_DATA=

# Test-only flag to keep the Electron window hidden while testing.
JARVIS_TEST_HIDE=0

# Optional test-only local model identifier. Tests skip when this is empty.
JARVIS_TEST_LOCAL_MODEL=
