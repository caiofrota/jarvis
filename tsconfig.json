{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2023",
      "dom.asynciterable"
    ],
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": [
      "node",
      "react",
      "react-dom",
      "dom-speech-recognition"
    ]
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.tsx",
    "components/**/*.tsx",
    "features/**/*.ts",
    "features/**/*.tsx",
    "client/**/*.ts",
    "shared/**/*.ts",
    "types/**/*.d.ts",
    "next.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "release",
    "features/voice/pcm-worklet.ts"
  ]
}
