# Node process. Export these values or pass --env-file; existing process values win.
# Server-only: never prefix these with NEXT_PUBLIC_.
DATABASE_URL=file:/absolute/path/to/rosie.sqlite
# Private installation key for sealing sessions; no longer a login password.
ROSIE_ADMIN_TOKEN_FILE=/path/to/existing/admin.token
# Optional staged build directory; default is .next.
ROSIE_NEXT_DIST_DIR=.next
ROSIE_VOICE_TOKEN_FILE=/path/to/private/speech-credential
ROSIE_VOICE_URL=http://127.0.0.1:8766
ROSIE_ORIGIN=http://127.0.0.1:8765
PORT=8765
HOST=127.0.0.1
# Optional direct TLS, generated for local development by pnpm setup:brain:https.
# Leave empty when HTTPS is terminated by a reverse proxy.
ROSIE_TLS_CERT_FILE=
ROSIE_TLS_KEY_FILE=
ROSIE_HTTP_REDIRECT_PORT=0
# One-time import tool only; never imports implicitly during normal startup.
ROSIE_LEGACY_CATALOG=/path/to/catalog.json
